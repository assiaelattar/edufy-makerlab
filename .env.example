VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only Edufy Agent API settings.
# Do not expose these with a VITE_ prefix.
EDUFY_AGENT_API_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the three Firebase values above:
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Server-only SparkQuest App Bridge. Keep false locally unless using isolated
# Auth/Firestore emulators. Enabling this permits one-time launch-session writes.
EDUFY_ENABLE_APP_BRIDGE_WRITES=false
SPARKQUEST_APP_URL=https://sparkquest-makerlab.vercel.app
SPARKQUEST_ALLOWED_ORIGINS=https://sparkquest-makerlab.vercel.app
EDUFY_ALLOWED_ORIGINS=https://edufy-makerlab.vercel.app
