VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only Edufy Agent API settings.
# Do not expose these with a VITE_ prefix.
EDUFY_AGENT_API_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative to the three Firebase values above:
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Server-only SparkQuest App Bridge. Keep false locally unless using isolated
# Auth/Firestore emulators. Enabling this permits one-time launch-session writes.
EDUFY_ENABLE_APP_BRIDGE_WRITES=false
SPARKQUEST_APP_URL=https://sparkquest-makerlab.vercel.app
SPARKQUEST_ALLOWED_ORIGINS=https://sparkquest-makerlab.vercel.app
EDUFY_ALLOWED_ORIGINS=https://edufy-makerlab.vercel.app

# Parent-access API deployment. Blank defaults to the trusted public
# https://edufy-makerlab.vercel.app API, including during local Edufy testing.
# Set only when using a different verified HTTPS API origin.
VITE_PARENT_ACCESS_API_ORIGIN=
# Set on the trusted API host to exact frontend origins (comma-separated).
# Include https://edufy.makerlab.academy when that Hostinger frontend calls it.
# Redeploy the Vercel Function after changing its environment variables.
EDUFY_PARENT_ACCESS_ALLOWED_ORIGINS=
