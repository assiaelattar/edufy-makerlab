rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identity helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return currentUser().data.role;
    }

    function currentOrgId() {
      return currentUser().data.organizationId;
    }

    function platformBootstrapComplete() {
      return exists(/databases/$(database)/documents/platformSettings/core) &&
        get(/databases/$(database)/documents/platformSettings/core).data.bootstrapComplete == true;
    }

    function isLegacyPlatformBootstrapAdmin() {
      return hasUserProfile() &&
        currentRole() == 'admin' &&
        currentOrgId() == 'makerlab-academy' &&
        !platformBootstrapComplete();
    }

    function isPlatformAdmin() {
      return (hasUserProfile() && currentRole() in ['super_admin']) || isLegacyPlatformBootstrapAdmin();
    }

    function isTenantAdmin() {
      return hasUserProfile() && currentRole() in ['owner', 'admin'];
    }

    function isElevatedUser() {
      return isPlatformAdmin() ||
        (hasUserProfile() && currentRole() in [
          'owner',
          'admin',
          'instructor',
          'admission_officer',
          'accountant',
          'content_manager'
        ]);
    }

    function isSameOrg(orgId) {
      return isPlatformAdmin() || (hasUserProfile() && orgId == currentOrgId());
    }

    function resourceHasOrg() {
      return resource.data.organizationId is string;
    }

    function requestHasOrg() {
      return request.resource.data.organizationId is string;
    }

    function canReadTenantDoc() {
      return isElevatedUser() && resourceHasOrg() && isSameOrg(resource.data.organizationId);
    }

    function canCreateTenantDoc() {
      return isElevatedUser() && requestHasOrg() && isSameOrg(request.resource.data.organizationId);
    }

    function canUpdateTenantDoc() {
      return isElevatedUser() &&
        resourceHasOrg() &&
        requestHasOrg() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        isSameOrg(resource.data.organizationId);
    }

    function canDeleteTenantDoc() {
      return isElevatedUser() && canReadTenantDoc();
    }

    function isAdmissionsOperator() {
      return hasUserProfile() && currentUser().data.get('status', '') == 'active' &&
        currentRole() in ['super_admin', 'owner', 'admin', 'admission_officer'];
    }

    function canReadAdmissionDoc() {
      return isAdmissionsOperator() && resourceHasOrg() && admissionSameOrg(resource.data.organizationId);
    }

    function admissionSameOrg(orgId) {
      return orgId == currentOrgId() || currentRole() == 'super_admin';
    }

    function admissionLeadMatchesOrg(leadId, orgId) {
      return exists(/databases/$(database)/documents/leads/$(leadId)) &&
        get(/databases/$(database)/documents/leads/$(leadId)).data.organizationId == orgId;
    }

    function validAdmissionNoteActivityCreate(activityId) {
      return isAdmissionsOperator() &&
        requestHasOrg() &&
        admissionSameOrg(request.resource.data.organizationId) &&
        request.resource.data.keys().hasOnly([
          'organizationId',
          'admissionCaseId',
          'legacyLeadId',
          'kind',
          'channel',
          'body',
          'outcome',
          'occurredAt',
          'actorId',
          'caseVersion',
          'commandFingerprint',
          'createdAt'
        ]) &&
        request.resource.data.admissionCaseId is string &&
        request.resource.data.legacyLeadId is string &&
        request.resource.data.kind == 'note' &&
        request.resource.data.channel == 'internal' &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 2000 &&
        request.resource.data.outcome == null &&
        request.resource.data.occurredAt is timestamp &&
        request.resource.data.occurredAt <= request.time + duration.value(5, 'm') &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.caseVersion is int &&
        request.resource.data.caseVersion > 0 &&
        request.resource.data.commandFingerprint is string &&
        request.resource.data.commandFingerprint.size() == 16 &&
        request.resource.data.createdAt == request.time &&
        admissionLeadMatchesOrg(request.resource.data.legacyLeadId, request.resource.data.organizationId) &&
        existsAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)) &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.organizationId == request.resource.data.organizationId &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.legacyLeadId == request.resource.data.legacyLeadId &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.version == request.resource.data.caseVersion &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.lastCommandId == activityId;
    }

    function admissionStoredWhatsAppConsent(caseId) {
      return exists(/databases/$(database)/documents/admission_case_states/$(caseId))
        ? get(/databases/$(database)/documents/admission_case_states/$(caseId)).data.get('whatsappConsentState', 'unknown')
        : 'unknown';
    }

    function validAdmissionConsentSnapshot(caseId) {
      let activity = getAfter(/databases/$(database)/documents/admission_activities/$(request.resource.data.lastCommandId)).data;
      return request.resource.data.get('whatsappConsentState', 'unknown') == (
        activity.get('communicationState', '') == 'consent_updated'
          ? activity.consentState
          : admissionStoredWhatsAppConsent(caseId)
      );
    }

    function validAdmissionWhatsAppActivityCreate(activityId) {
      return isAdmissionsOperator() &&
        requestHasOrg() &&
        admissionSameOrg(request.resource.data.organizationId) &&
        request.resource.data.keys().hasOnly([
          'organizationId',
          'admissionCaseId',
          'legacyLeadId',
          'kind',
          'channel',
          'body',
          'outcome',
          'communicationState',
          'consentState',
          'templateId',
          'occurredAt',
          'actorId',
          'caseVersion',
          'commandFingerprint',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'organizationId',
          'admissionCaseId',
          'legacyLeadId',
          'kind',
          'channel',
          'body',
          'outcome',
          'communicationState',
          'consentState',
          'templateId',
          'occurredAt',
          'actorId',
          'caseVersion',
          'commandFingerprint',
          'createdAt'
        ]) &&
        request.resource.data.admissionCaseId is string &&
        request.resource.data.legacyLeadId is string &&
        request.resource.data.kind == 'follow_up' &&
        request.resource.data.channel == 'whatsapp' &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 2000 &&
        request.resource.data.communicationState in [
          'consent_updated',
          'prepared',
          'launched',
          'operator_confirmed_sent',
          'operator_confirmed_not_sent',
          'parent_response_recorded'
        ] &&
        request.resource.data.consentState in ['unknown', 'granted', 'opted_out'] &&
        (request.resource.data.communicationState == 'consent_updated' ||
          request.resource.data.consentState == admissionStoredWhatsAppConsent(request.resource.data.admissionCaseId)) &&
        request.resource.data.templateId is string &&
        request.resource.data.templateId.size() > 0 &&
        request.resource.data.templateId.size() <= 128 &&
        (
          (request.resource.data.communicationState == 'parent_response_recorded' &&
            request.resource.data.outcome in [
              'connected',
              'no_answer',
              'asked_to_follow_up',
              'interested',
              'not_interested',
              'wrong_contact'
            ]) ||
          (request.resource.data.communicationState != 'parent_response_recorded' && request.resource.data.outcome == null)
        ) &&
        !(request.resource.data.communicationState == 'prepared' && request.resource.data.consentState == 'opted_out') &&
        !(
          request.resource.data.communicationState in ['launched', 'operator_confirmed_sent'] &&
          request.resource.data.consentState != 'granted'
        ) &&
        request.resource.data.occurredAt is timestamp &&
        request.resource.data.occurredAt <= request.time + duration.value(5, 'm') &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.caseVersion is int &&
        request.resource.data.caseVersion > 0 &&
        request.resource.data.commandFingerprint is string &&
        request.resource.data.commandFingerprint.size() == 16 &&
        request.resource.data.createdAt == request.time &&
        admissionLeadMatchesOrg(request.resource.data.legacyLeadId, request.resource.data.organizationId) &&
        existsAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)) &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.organizationId == request.resource.data.organizationId &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.legacyLeadId == request.resource.data.legacyLeadId &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.version == request.resource.data.caseVersion &&
        getAfter(/databases/$(database)/documents/admission_case_states/$(request.resource.data.admissionCaseId)).data.lastCommandId == activityId;
    }

    function validAdmissionCaseStateCreate(caseId) {
      let activity = getAfter(/databases/$(database)/documents/admission_activities/$(request.resource.data.lastCommandId)).data;
      return isAdmissionsOperator() &&
        requestHasOrg() &&
        admissionSameOrg(request.resource.data.organizationId) &&
        request.resource.data.keys().hasOnly([
          'whatsappConsentState',
          'organizationId',
          'admissionCaseId',
          'legacyLeadId',
          'version',
          'openNextActionId',
          'lastActivityAt',
          'lastActivityKind',
          'lastCommandId',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ]) &&
        request.resource.data.admissionCaseId == caseId &&
        validAdmissionConsentSnapshot(caseId) &&
        request.resource.data.legacyLeadId is string &&
        request.resource.data.version == 1 &&
        request.resource.data.openNextActionId == null &&
        request.resource.data.lastActivityAt is timestamp &&
        request.resource.data.lastActivityKind in ['note', 'follow_up'] &&
        request.resource.data.lastCommandId is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        admissionLeadMatchesOrg(request.resource.data.legacyLeadId, request.resource.data.organizationId) &&
        activity.organizationId == request.resource.data.organizationId &&
        activity.admissionCaseId == caseId &&
        activity.legacyLeadId == request.resource.data.legacyLeadId &&
        activity.kind == request.resource.data.lastActivityKind &&
        activity.caseVersion == 1;
    }

    function validAdmissionCaseStateUpdate(caseId) {
      let activity = getAfter(/databases/$(database)/documents/admission_activities/$(request.resource.data.lastCommandId)).data;
      return isAdmissionsOperator() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        admissionSameOrg(resource.data.organizationId) &&
        request.resource.data.admissionCaseId == caseId &&
        validAdmissionConsentSnapshot(caseId) &&
        request.resource.data.admissionCaseId == resource.data.admissionCaseId &&
        request.resource.data.legacyLeadId == resource.data.legacyLeadId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.openNextActionId == resource.data.openNextActionId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'whatsappConsentState',
          'version',
          'lastActivityAt',
          'lastActivityKind',
          'lastCommandId',
          'updatedAt',
          'updatedBy'
        ]) &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.lastActivityKind in ['note', 'follow_up'] &&
        request.resource.data.lastCommandId is string &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        admissionLeadMatchesOrg(resource.data.legacyLeadId, resource.data.organizationId) &&
        activity.organizationId == resource.data.organizationId &&
        activity.admissionCaseId == caseId &&
        activity.legacyLeadId == resource.data.legacyLeadId &&
        activity.kind == request.resource.data.lastActivityKind &&
        activity.caseVersion == request.resource.data.version &&
        activity.occurredAt == request.resource.data.lastActivityAt;
    }

    function canManageTenantOrg(orgId) {
      return isPlatformAdmin() || (isTenantAdmin() && orgId == currentOrgId());
    }

    function canCreateTenantUser() {
      return isPlatformAdmin() || (
        isTenantAdmin() &&
        requestHasOrg() &&
        isSameOrg(request.resource.data.organizationId) &&
        (
          (currentRole() == 'owner' && !(request.resource.data.role in ['super_admin', 'owner'])) ||
          (currentRole() == 'admin' && !(request.resource.data.role in ['super_admin', 'owner', 'admin']))
        )
      );
    }

    function canUpdateTenantUser() {
      return isPlatformAdmin() || (
        isTenantAdmin() &&
        resourceHasOrg() &&
        requestHasOrg() &&
        resource.data.organizationId == currentOrgId() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        (
          (currentRole() == 'owner' && !(resource.data.role in ['super_admin', 'owner']) && !(request.resource.data.role in ['super_admin', 'owner'])) ||
          (currentRole() == 'admin' && !(resource.data.role in ['super_admin', 'owner', 'admin']) && !(request.resource.data.role in ['super_admin', 'owner', 'admin']))
        )
      );
    }

    function canDeleteTenantUser(userId) {
      return isPlatformAdmin() || (
        isTenantAdmin() &&
        resourceHasOrg() &&
        resource.data.organizationId == currentOrgId() &&
        request.auth.uid != userId &&
        (
          (currentRole() == 'owner' && !(resource.data.role in ['super_admin', 'owner'])) ||
          (currentRole() == 'admin' && !(resource.data.role in ['super_admin', 'owner', 'admin']))
        )
      );
    }

    function programMatchesOrg(programId, orgId) {
      return exists(/databases/$(database)/documents/programs/$(programId)) &&
        get(/databases/$(database)/documents/programs/$(programId)).data.organizationId == orgId;
    }

    function workshopTemplateMatchesOrg(templateId, orgId) {
      return exists(/databases/$(database)/documents/workshop_templates/$(templateId)) &&
        get(/databases/$(database)/documents/workshop_templates/$(templateId)).data.organizationId == orgId;
    }

    function workshopSlotMatchesOrg(slotId, orgId, templateId) {
      return exists(/databases/$(database)/documents/workshop_slots/$(slotId)) &&
        get(/databases/$(database)/documents/workshop_slots/$(slotId)).data.organizationId == orgId &&
        get(/databases/$(database)/documents/workshop_slots/$(slotId)).data.workshopTemplateId == templateId;
    }

    function organizationOwnedByRequester(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid;
    }

    function studentLinkedToRequester(studentId, orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.organizationId == orgId &&
        (
          (
            get(/databases/$(database)/documents/students/$(studentId)).data.keys().hasAny(['loginInfo']) &&
            get(/databases/$(database)/documents/students/$(studentId)).data.loginInfo.uid == request.auth.uid
          ) ||
          (
            get(/databases/$(database)/documents/students/$(studentId)).data.keys().hasAny(['parentLoginInfo']) &&
            get(/databases/$(database)/documents/students/$(studentId)).data.parentLoginInfo.uid == request.auth.uid
          ) ||
          (
            get(/databases/$(database)/documents/students/$(studentId)).data.keys().hasAny(['parentUids']) &&
            get(/databases/$(database)/documents/students/$(studentId)).data.parentUids.hasAny([request.auth.uid])
          )
        ) || guardianSubjectLinkedToRequester(studentId, orgId);
    }

    function studentRecordOwnedByRequester(studentData) {
      return isSignedIn() &&
        hasUserProfile() &&
        currentRole() == 'student' &&
        studentData.organizationId == currentOrgId() &&
        studentData.keys().hasAny(['loginInfo']) &&
        studentData.loginInfo.uid == request.auth.uid;
    }

    function guardianSubjectLinkedToRequester(subjectId, orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + subjectId)) &&
        get(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + subjectId)).data.parentUid == request.auth.uid &&
        get(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + subjectId)).data.organizationId == orgId &&
        get(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + subjectId)).data.status == 'active';
    }

    function enrollmentLinkedToRequester(enrollmentId, orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/enrollments/$(enrollmentId)) &&
        get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.organizationId == orgId &&
        studentLinkedToRequester(
          get(/databases/$(database)/documents/enrollments/$(enrollmentId)).data.studentId,
          orgId
        );
    }

    function canCreateOwnStudentProject() {
      return hasUserProfile() && currentRole() == 'student' && requestHasOrg() &&
        request.resource.data.organizationId == currentOrgId() &&
        (
          request.resource.data.studentId == request.auth.uid ||
          studentLinkedToRequester(request.resource.data.studentId, request.resource.data.organizationId)
        );
    }

    function canUpdateOwnStudentProject() {
      return hasUserProfile() && currentRole() == 'student' && resourceHasOrg() && requestHasOrg() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.studentId == resource.data.studentId &&
        (
          resource.data.studentId == request.auth.uid ||
          studentLinkedToRequester(resource.data.studentId, resource.data.organizationId)
        );
    }

    function canReadLegacyStudentProject() {
      return hasUserProfile() && !resourceHasOrg() && resource.data.studentId is string &&
        (
          resource.data.studentId == request.auth.uid ||
          studentLinkedToRequester(resource.data.studentId, currentOrgId()) ||
          guardianSubjectLinkedToRequester(resource.data.studentId, currentOrgId())
        );
    }

    function canMigrateOwnLegacyStudentProject() {
      return hasUserProfile() && currentRole() == 'student' && !resourceHasOrg() && requestHasOrg() &&
        request.resource.data.organizationId == currentOrgId() &&
        request.resource.data.studentId == resource.data.studentId &&
        (
          resource.data.studentId == request.auth.uid ||
          studentLinkedToRequester(resource.data.studentId, currentOrgId())
        );
    }

    function validOwnUserCreate(userId) {
      return isOwner(userId) &&
        requestHasOrg() &&
        request.resource.data.role in ['guest', 'parent', 'student', 'owner', 'admin'] &&
        (
          request.resource.data.role in ['guest', 'parent', 'student'] ||
          organizationOwnedByRequester(request.resource.data.organizationId)
        );
    }

    function validOwnUserUpdate(userId) {
      return isOwner(userId) &&
        resourceHasOrg() &&
        requestHasOrg() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.role == resource.data.role;
    }

    // --- Narrow public entry points ---
    function validPublicLeadCreate() {
      return requestHasOrg() &&
        request.resource.data.keys().hasOnly([
          'organizationId',
          'name',
          'parentName',
          'phone',
          'email',
          'source',
          'status',
          'interests',
          'programId',
          'selectedPack',
          'selectedSlot',
          'selectedGradeId',
          'selectedGroupId',
          'secondGroupId',
          'campSessionId',
          'campShiftId',
          'moduleIds',
          'preferredPaymentTerm',
          'paymentMethod',
          'notes',
          'tags',
          'timeline',
          'createdAt'
        ]) &&
        request.resource.data.programId is string &&
        programMatchesOrg(request.resource.data.programId, request.resource.data.organizationId) &&
        (request.resource.data.get('selectedGradeId', null) == null || request.resource.data.get('selectedGradeId', null) is string) &&
        (request.resource.data.get('selectedGroupId', null) == null || request.resource.data.get('selectedGroupId', null) is string) &&
        (request.resource.data.get('secondGroupId', null) == null || request.resource.data.get('secondGroupId', null) is string) &&
        (request.resource.data.get('campSessionId', null) == null || request.resource.data.get('campSessionId', null) is string) &&
        (request.resource.data.get('campShiftId', null) == null || request.resource.data.get('campShiftId', null) is string) &&
        request.resource.data.get('moduleIds', []) is list &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;
    }

    function validPublicWorkshopSlotCreate() {
      return requestHasOrg() &&
        request.resource.data.keys().hasOnly([
          'organizationId',
          'workshopTemplateId',
          'date',
          'startTime',
          'endTime',
          'capacity',
          'bookedCount',
          'status'
        ]) &&
        request.resource.data.workshopTemplateId is string &&
        workshopTemplateMatchesOrg(request.resource.data.workshopTemplateId, request.resource.data.organizationId) &&
        request.resource.data.bookedCount == 0 &&
        request.resource.data.capacity is int &&
        request.resource.data.capacity > 0 &&
        request.resource.data.status == 'available';
    }

    function validPublicWorkshopSlotIncrement() {
      return resourceHasOrg() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.workshopTemplateId == resource.data.workshopTemplateId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedCount']) &&
        request.resource.data.bookedCount == resource.data.bookedCount + 1 &&
        request.resource.data.bookedCount <= resource.data.capacity;
    }

    function validPublicBookingCreate() {
      return requestHasOrg() &&
        request.resource.data.keys().hasOnly([
          'organizationId',
          'workshopSlotId',
          'workshopTemplateId',
          'parentName',
          'phoneNumber',
          'kidName',
          'kidAge',
          'kidInterests',
          'status',
          'bookedAt',
          'notes',
          'feedbackNotes',
          'programInterest'
        ]) &&
        request.resource.data.workshopTemplateId is string &&
        request.resource.data.workshopSlotId is string &&
        workshopTemplateMatchesOrg(request.resource.data.workshopTemplateId, request.resource.data.organizationId) &&
        workshopSlotMatchesOrg(request.resource.data.workshopSlotId, request.resource.data.organizationId, request.resource.data.workshopTemplateId) &&
        request.resource.data.status == 'confirmed' &&
        request.resource.data.bookedAt == request.time;
    }

    function validLinkedPickupCreate() {
      return hasUserProfile() &&
        currentRole() in ['parent', 'student'] &&
        requestHasOrg() &&
        isSameOrg(request.resource.data.organizationId) &&
        request.resource.data.status == 'on_the_way' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.notifiedAt == request.time &&
        request.resource.data.keys().hasOnly([
          'organizationId',
          'studentId',
          'studentName',
          'parentName',
          'pickerName',
          'pickerRelation',
          'status',
          'notifiedAt',
          'createdAt'
        ]) &&
        studentLinkedToRequester(request.resource.data.studentId, request.resource.data.organizationId);
    }

    function validLinkedPickupUpdate() {
      return hasUserProfile() &&
        currentRole() in ['parent', 'student'] &&
        resourceHasOrg() &&
        requestHasOrg() &&
        request.resource.data.organizationId == resource.data.organizationId &&
        isSameOrg(resource.data.organizationId) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'arrivedAt', 'confirmedAt']) &&
        request.resource.data.status in ['arrived', 'confirmed'] &&
        studentLinkedToRequester(resource.data.studentId, resource.data.organizationId);
    }

    // --- Identity and tenancy ---
    match /users/{userId} {
      allow read: if isOwner(userId) ||
        isPlatformAdmin() ||
        (isSignedIn() && resource.data.email == request.auth.token.email) ||
        (isElevatedUser() && resourceHasOrg() && isSameOrg(resource.data.organizationId));

      allow create: if validOwnUserCreate(userId) || canCreateTenantUser();
      allow update: if validOwnUserUpdate(userId) || canUpdateTenantUser();
      allow delete: if canDeleteTenantUser(userId);
    }

    match /guardian_links/{linkId} {
      allow read: if (isSignedIn() && resource.data.parentUid == request.auth.uid) || canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /organizations/{orgId} {
      allow read: if isPlatformAdmin() || isSameOrg(orgId);
      allow create: if isPlatformAdmin() || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow update, delete: if canManageTenantOrg(orgId);

      match /settings/{settingId} {
        allow read: if isPlatformAdmin() || isSameOrg(orgId);
        allow write: if canManageTenantOrg(orgId);
      }

      match /roles/{roleId} {
        allow read: if isPlatformAdmin() || isSameOrg(orgId);
        allow write: if canManageTenantOrg(orgId);
      }

      // Keep the existing organization-manager boundary for service billing.
      // This explicit exclusion prevents the legacy recursive grant bypassing validation.
      match /{subcollection}/{allSubcollections=**} {
        allow read, write: if subcollection != 'serviceCatalogue' && canManageTenantOrg(orgId);
      }

      match /serviceCatalogue/{serviceId} {
        function serviceOperator() {
          return canManageTenantOrg(orgId) && currentUser().data.get('status', '') == 'active';
        }
        function validService() {
          let value = request.resource.data;
          return value.keys().hasOnly(['organizationId', 'name', 'description', 'category', 'unitLabel', 'quantity', 'unitPrice', 'taxRate', 'status', 'source', 'version', 'createdAt', 'updatedAt']) &&
            value.organizationId == orgId &&
            value.name is string && value.name.size() > 0 && value.name.size() <= 160 &&
            value.description is string && value.description.size() <= 4000 &&
            value.category is string && value.category.size() <= 80 &&
            value.unitLabel is string && value.unitLabel.size() > 0 && value.unitLabel.size() <= 80 &&
            value.quantity is number && value.quantity > 0 && value.quantity <= 1000000 &&
            (value.unitPrice == null || (value.unitPrice is number && value.unitPrice >= 0 && value.unitPrice <= 1000000000)) &&
            value.taxRate is number && value.taxRate >= 0 && value.taxRate <= 100 &&
            value.status in ['active', 'archived'] &&
            value.source is string && value.source.size() <= 200 &&
            value.version is int && value.updatedAt == request.time;
        }
        allow read: if serviceOperator();
        allow create: if serviceOperator() && validService() && request.resource.data.version == 1 && request.resource.data.createdAt == request.time;
        allow update: if serviceOperator() && validService() && resource.data.organizationId == orgId && request.resource.data.version == resource.data.version + 1 && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }

    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }

    match /moduleCatalog/{itemId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    match /platformSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // --- Core Edufy tenant data ---
    match /students/{studentId} {
      allow read: if canReadTenantDoc() ||
        studentLinkedToRequester(studentId, resource.data.organizationId) ||
        studentRecordOwnedByRequester(resource.data);
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /programs/{programId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /enrollments/{enrollmentId} {
      allow read: if canReadTenantDoc() ||
        (resourceHasOrg() && studentLinkedToRequester(resource.data.studentId, resource.data.organizationId));
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /payments/{paymentId} {
      allow read: if canReadTenantDoc() ||
        (resourceHasOrg() && enrollmentLinkedToRequester(resource.data.enrollmentId, resource.data.organizationId));
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /expenses/{expenseId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /expense_templates/{templateId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /attendance/{recordId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /staff_attendance/{recordId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    // --- Learning and LMS shared collections ---
    match /project_templates/{templateId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /student_projects/{projectId} {
      allow read: if canReadTenantDoc() ||
        canReadLegacyStudentProject() ||
        (resourceHasOrg() && (
          studentLinkedToRequester(resource.data.studentId, resource.data.organizationId) ||
          guardianSubjectLinkedToRequester(resource.data.studentId, resource.data.organizationId) ||
          (hasUserProfile() && currentRole() == 'student' && resource.data.studentId == request.auth.uid && resource.data.organizationId == currentOrgId())
        ));
      allow create: if canCreateTenantDoc() || canCreateOwnStudentProject();
      allow update: if canUpdateTenantDoc() || canUpdateOwnStudentProject() || canMigrateOwnLegacyStudentProject();
      allow delete: if canDeleteTenantDoc();
    }

    match /process_templates/{workflowId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /stations/{stationId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    // --- Workshops and public booking ---
    match /workshop_templates/{templateId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /workshop_slots/{slotId} {
      allow read: if true;
      allow create: if canCreateTenantDoc() || validPublicWorkshopSlotCreate();
      allow update: if canUpdateTenantDoc() || validPublicWorkshopSlotIncrement();
      allow delete: if canDeleteTenantDoc();
    }

    match /bookings/{bookingId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc() || validPublicBookingCreate();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /workshop_evaluations/{evalId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    // --- CRM, communications, and operations ---
    match /leads/{leadId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc() || validPublicLeadCreate();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /admission_case_states/{caseId} {
      allow get: if isAdmissionsOperator() && (resource == null || canReadAdmissionDoc());
      allow list: if canReadAdmissionDoc();
      allow create: if validAdmissionCaseStateCreate(caseId);
      allow update: if validAdmissionCaseStateUpdate(caseId);
      allow delete: if false;
    }

    match /admission_activities/{activityId} {
      allow get: if isAdmissionsOperator() && (resource == null || canReadAdmissionDoc());
      allow list: if canReadAdmissionDoc();
      allow create: if (request.resource.data.kind == 'note' && validAdmissionNoteActivityCreate(activityId)) ||
        (request.resource.data.kind == 'follow_up' && validAdmissionWhatsAppActivityCreate(activityId));
      allow update, delete: if false;
    }

    match /admission_tasks/{taskId} {
      allow read: if canReadAdmissionDoc();
      allow write: if false;
    }

    match /marketing_posts/{postId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /campaigns/{campaignId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /tasks/{taskId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /projects/{projectId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /messages/{messageId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /tool_links/{linkId} {
      allow read: if canReadTenantDoc() || (hasUserProfile() && currentRole() == 'student' && resourceHasOrg() && isSameOrg(resource.data.organizationId));
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /archive_links/{linkId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /gallery_items/{itemId} {
      allow read: if canReadTenantDoc() ||
        (resourceHasOrg() && resource.data.studentId is string && (
          studentLinkedToRequester(resource.data.studentId, resource.data.organizationId) ||
          guardianSubjectLinkedToRequester(resource.data.studentId, resource.data.organizationId)
        ));
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /assets/{assetId} {
      allow read: if canReadTenantDoc();
      allow create: if canCreateTenantDoc();
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /pickup_queue/{entryId} {
      allow read: if canReadTenantDoc() ||
        (resourceHasOrg() && studentLinkedToRequester(resource.data.studentId, resource.data.organizationId));
      allow create: if canCreateTenantDoc() || validLinkedPickupCreate();
      allow update: if canUpdateTenantDoc() || validLinkedPickupUpdate();
      allow delete: if canDeleteTenantDoc();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isElevatedUser());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isElevatedUser());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isElevatedUser());
      allow delete: if isElevatedUser();
    }

    match /focus_sessions/{sessionId} {
      allow read: if canReadTenantDoc() ||
        (resourceHasOrg() && isSameOrg(resource.data.organizationId) &&
          hasUserProfile() && currentRole() == 'student' && (
            resource.data.studentId == request.auth.uid ||
            studentLinkedToRequester(resource.data.studentId, resource.data.organizationId)
          ));
      allow create: if requestHasOrg() && isSameOrg(request.resource.data.organizationId) &&
        hasUserProfile() && currentRole() == 'student' && (
          request.resource.data.studentId == request.auth.uid ||
          studentLinkedToRequester(request.resource.data.studentId, request.resource.data.organizationId)
        );
      allow update: if resourceHasOrg() && requestHasOrg() &&
        resource.data.organizationId == request.resource.data.organizationId &&
        isSameOrg(resource.data.organizationId) &&
        hasUserProfile() && currentRole() == 'student' && (
          resource.data.studentId == request.auth.uid ||
          studentLinkedToRequester(resource.data.studentId, resource.data.organizationId)
        ) &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if canDeleteTenantDoc();
    }

    // --- Legacy and support collections ---
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isElevatedUser();
    }

    match /registrations/{regId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isElevatedUser();
    }

    match /purchase_requests/{reqId} {
      allow read: if canReadTenantDoc();
      allow create: if requestHasOrg() && isSameOrg(request.resource.data.organizationId);
      allow update: if canUpdateTenantDoc();
      allow delete: if canDeleteTenantDoc();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isElevatedUser();
    }

    match /gadgets/{gadgetId} {
      allow read: if true;
      allow write: if isElevatedUser();
    }

    match /contests/{contestId} {
      allow read: if true;
      allow write: if isElevatedUser();
    }

    match /_connection_test/{testId} {
      allow write: if isSignedIn();
    }

    match /agent_audit_logs/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /system_logs/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isElevatedUser();
    }

    // --- Default deny ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
