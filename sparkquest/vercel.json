{
    "images": {
        "sizes": [320, 640, 960],
        "qualities": [65],
        "formats": ["image/webp"],
        "minimumCacheTTL": 60,
        "localPatterns": [
            { "pathname": "^/.*\\.(?:png|jpg|jpeg|webp)$", "search": "" }
        ],
        "remotePatterns": [
            { "protocol": "https", "hostname": "firebasestorage.googleapis.com", "pathname": "^/v0/b/edufy-makerlab\\.(?:firebasestorage\\.app|appspot\\.com)/o/.*$" },
            { "protocol": "https", "hostname": "storage.googleapis.com", "pathname": "^/edufy-makerlab\\.(?:firebasestorage\\.app|appspot\\.com)/.*$" }
        ]
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*).html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}
